# top-most EditorConfig file
root = true

# C# code style and formatting rules

[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8

# Sort and separate using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Remove unnecessary usings (IDE0005)
dotnet_diagnostic.IDE0005.severity = warning

# Prefer file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:suggestion

# Accessibility modifiers required
dotnet_style_require_accessibility_modifiers = always:warning

# Prefer 'var' for built-in types only
dotnet_style_var_for_built_in_types = false:suggestion
dotnet_style_var_when_type_is_apparent = true:suggestion
dotnet_style_var_elsewhere = false:suggestion

# Expression-bodied members preferences
csharp_style_expression_bodied_methods = when_possible:suggestion
csharp_style_expression_bodied_properties = when_possible:suggestion
csharp_style_expression_bodied_constructors = when_possible:suggestion

# Prefer 'using' directives inside namespace
csharp_style_prefer_top_level_statements = true:suggestion

# Prefer 'readonly' on fields where possible
dotnet_style_readonly_field = true:suggestion

# Prefer pattern matching
csharp_style_prefer_pattern_matching = true:suggestion

# Prefer simple 'default' literal
csharp_style_prefer_simple_default_expression = true:suggestion

# Prefer switch expressions
csharp_style_prefer_switch_expression = true:suggestion

# Prefer collection initializers
dotnet_style_collection_initializer = true:suggestion

# Prefer object initializers
dotnet_style_object_initializer = true:suggestion

# Prefer null propagating operator
dotnet_style_prefer_null_propagation = true:suggestion

# Prefer coalesce expression
dotnet_style_coalesce_expression = true:suggestion

# Prefer simplified boolean expressions
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion

# Enforce trailing commas in multi-line initializers
dotnet_style_allow_multiple_blank_lines_experimental = false:suggestion

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2