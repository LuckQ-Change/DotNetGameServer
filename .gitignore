###############################################
# OS / IDE caches
###############################################
.DS_Store
Thumbs.db
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

###############################################
# .NET build outputs
###############################################
[Bb]in/
[Oo]bj/
[Ll]og/
build/
bld/
artifacts/
out/
publish/
dist/

# Global build directories at any depth
**/[Bb]uild*/
**/[Bb]in/
**/[Oo]bj/
**/[Pp]ublish*/
**/dist/
**/out/

###############################################
# DotNet / NuGet
###############################################
packages/
*.nupkg
*.snupkg
*.nuspec
project.lock.json
*.deps.json
*.runtimeconfig.json

###############################################
# Symbols / caches / logs / test artifacts
###############################################
*.pdb
*.mdb
*.cache
*.tmp
*.log
TestResults/
*.trx

###############################################
# Node.js (Tooling)
###############################################
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

###############################################
# Rider / ReSharper
###############################################
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

###############################################
# Coverage
###############################################
coverage/
lcov.info

###############################################
# Local secrets or environment overrides (optional)
###############################################
appsettings.Local.json
*.local.json

###############################################
# Compiled binaries (defensive)
###############################################
**/*.dll
**/*.exe
**/*.so
**/*.dylib
**/*.a

# 永远跟踪所有 .proto 文件（即使位于被忽略的目录中）
!**/*.proto
