{
  "port": 5500,
  "service": {
    "healthCheckUrl": "http://127.0.0.1:8080"
  },
  "server": {
    "listenAddress": "127.0.0.1",
    "maxMessageSizeBytes": 1048576,
    "maxConcurrentConnections": 200,
    "connectionQueueCapacity": 256,
    "maxConcurrentRequestsPerConnection": 4,
    "requestTimeoutMs": 30000,
    "startupTimeoutMs": 30000,
    "shutdownTimeoutMs": 15000,
    "listenBacklog": 512,
    "allowUnspecifiedChannel": false,
    "receiveTimeoutMs": 10000,
    "idleTimeoutMs": 120000
  },
  "authentication": {
    "audience": "DemoGameServer",
    "clockSkewSeconds": 30,
    "requireClientAuthentication": false,
    "requireInternalAuthentication": true
  },
  "clientHeartbeat": {
    "enabled": false,
    "recommendedIntervalSeconds": 20
  },
  "gameLogging": {
    "enabled": true,
    "minimumLevel": "Information",
    "forwardToILogger": true,
    "fileEnabled": true,
    "fileDirectory": "logs",
    "fileMaxMegabytes": 20,
    "fileRetentionDays": 14
  },
  "database": {
    "enabled": false
  },
  "serverRpc": {
    "maxPooledConnections": 256,
    "idleConnectionTimeoutSeconds": 60,
    "poolCleanupIntervalSeconds": 15
  },
  "telemetry": {
    "metrics": {
      "enabled": false
    }
  }
}
