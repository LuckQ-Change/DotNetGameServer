{
  "repo": {
    "path": "${{ github.workspace }}"
  },
  "model": {
    "provider": "http",
    "options": {
      "endpoint": "${{ secrets.AI_HTTP_ENDPOINT }}",
      "apiKey": "${{ secrets.AI_HTTP_TOKEN }}",
      "authHeaderPrefix": "${{ secrets.AI_HTTP_AUTH_PREFIX }}"
    }
  },
  "notifications": {
    "wecom": {
      "enabled": true,
      "webhook": "${{ secrets.WECOM_WEBHOOK }}"
    }
  },
  "schedule": {
    "intervalMinutes": 0,
    "dailyTime": "",
    "cron": ""
  },
  "review": {
    "maxSnippetsPerCommit": 2,
    "maxLinesPerSnippet": 20
  },
  "mention_map": {
    "email_to_lark_open_id": {},
    "email_to_wecom_userid": {
      "wujiaqing2020w@163.com": "武家庆"
    }
  },
}