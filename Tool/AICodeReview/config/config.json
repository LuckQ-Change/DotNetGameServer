{
  "repo": {
    "path": "${{ github.workspace }}"
  },
  "model": {
    "provider": "openai_chat",
    "options": {
      "baseURL": "${{ secrets.AI_BASE_URL }}",
      "apiKey": "${{ secrets.AI_API_KEY }}",
      "model": "${{ secrets.AI_MODEL }}"
    }
  },
  "notifications": {
    "wecom": {
      "enabled": true,
      "webhook": "${{ secrets.WECOM_WEBHOOK }}"
    }
  },
  "schedule": {
    "intervalMinutes": 0,
    "dailyTime": "",
    "cron": ""
  },
  "review": {
    "maxSnippetsPerCommit": 2,
    "maxLinesPerSnippet": 20
  },
  "mention_map": {
    "email_to_lark_open_id": {},
    "email_to_wecom_userid": {
      "wujiaqing2020w@163.com": "武家庆"
    }
  }
}