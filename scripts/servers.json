{
  "$schema": "./servers.schema.json",
  "build": {
    "solution": "DotNetGameServer.sln",
    "configuration": "Debug"
  },
  "servers": [
    {
      "name": "Directory",
      "project": "src/Servers/DirectoryServer/DirectoryServer.csproj",
      "dll": "DirectoryServer.dll",
      "port": 5500,
      "healthPort": 5101,
      "default": true
    },
    {
      "name": "Login",
      "project": "src/Servers/LoginServer/LoginServer.csproj",
      "dll": "LoginServer.dll",
      "port": 5501,
      "healthPort": 5102
    },
    {
      "name": "Logic",
      "project": "src/Servers/LogicServer/LogicServer.csproj",
      "dll": "LogicServer.dll",
      "port": 5502,
      "healthPort": 5103
    },
    {
      "name": "Battle",
      "project": "src/Servers/BattleServer/BattleServer.csproj",
      "dll": "BattleServer.dll",
      "port": 5503,
      "healthPort": 5104
    }
  ]
}
