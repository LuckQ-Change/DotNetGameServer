{
  "service": {
    "type": "directory",
    "port": 5500
  },
  "directory": {
    "tokenSecret": "__FROM_SECRET__",
    "registry": {
      "mode": "redis"
      // 注意：生产环境不在 appsettings 中写明连接串，改由环境变量或 Secret 注入
      // "redis": { "connectionString": "__FROM_SECRET__" }
    }
  },
  "server": {
    "maxConcurrentConnections": 1000,
    "receiveTimeoutMs": 5000,
    "acceptBackoffMs": 100
  }
}