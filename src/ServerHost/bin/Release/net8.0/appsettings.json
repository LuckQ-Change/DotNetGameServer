{
  "service": {
    "type": "directory",
    "port": 5500
  },
  "server": {
    "maxMessageSizeBytes": 1048576,
    "maxConcurrentConnections": 200,
    "receiveTimeoutMs": 10000,
    "acceptBackoffMs": 200,
    "maxBytesPerSecond": 1000000,
    "maxMessagesPerSecond": 200,
    "idleTimeoutMs": 120000
  },
  "directory": {
    "tokenSecret": "changeme-dev",
    "registry": {
      "mode": "memory",
      "redis": {
        "connectionString": "localhost:6379",
        "ssl": false,
        "sslHost": "",
        "clientCertificate": {
          "path": "",
          "password": ""
        },
        "validateServerCertificate": true,
        "offlineTtlSeconds": 120,
        "removeTtlSeconds": 600,
        "cleanupIntervalSeconds": 10
      }
    }
  },
  "heartbeat": {
    "region": "dev",
    "capacity": 100,
    "intervalSeconds": 5,
    "host": "127.0.0.1"
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "root",
    "password": "password",
    "database": "game"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "telemetry": {
    "metrics": {
      "enabled": true,
      "mode": "prometheus",
      "prometheus": {
        "port": 9464
      },
      "otlp": {
        "endpoint": "http://otel-collector:4318"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=game;Username=postgres;Password=password"
  }
}