{
  "server": {
    "maxMessageSizeBytes": 1048576,
    "maxConcurrentConnections": 200,
    "receiveTimeoutMs": 10000,
    "acceptBackoffMs": 200,
    "maxBytesPerSecond": 1000000,
    "maxMessagesPerSecond": 200,
    "idleTimeoutMs": 120000
  },
  "directory": {
    "tokenSecret": "dev-secret",
    "registry": {
      "mode": "memory",
      "redis": {
        "connectionString": "localhost:6379",
        "offlineTtlSeconds": 120,
        "removeTtlSeconds": 600,
        "cleanupIntervalSeconds": 10
      }
    }
  },
  "logging": {
    "minimumLevel": "Information",
    "enabled": true,
    "cacheCapacity": 2000,
    "heartbeatEnabled": false,
    "forwardToILogger": false
  },
  "telemetry": {
    "metrics": {
      "enabled": false,
      "otlp": {
        "endpoint": "http://otel-collector:4318"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
