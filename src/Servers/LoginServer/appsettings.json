{
  "server": {
    "maxMessageSizeBytes": 1048576,
    "maxConcurrentConnections": 200,
    "receiveTimeoutMs": 10000,
    "acceptBackoffMs": 200,
    "maxBytesPerSecond": 1000000,
    "maxMessagesPerSecond": 200,
    "idleTimeoutMs": 120000
  },
  "directory": {
    "tokenSecret": "dev-secret"
  },
  "heartbeat": {
    "region": "dev",
    "capacity": 100,
    "intervalSeconds": 5,
    "host": "127.0.0.1",
    "directoryHost": "127.0.0.1",
    "directoryPort": 5500
  },
  "logging": {
    "minimumLevel": "Information",
    "enabled": true,
    "cacheCapacity": 2000,
    "heartbeatEnabled": false,
    "forwardToILogger": false
  },
  "telemetry": {
    "metrics": {
      "enabled": false,
      "otlp": {
        "endpoint": "http://otel-collector:4318"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
